---
import '../styles/global.css';
import Assistant from '../components/Assistant.astro';
import config from '../../content/config.json';

interface Props {
  titre: string;
  description: string;
  /** Masquer la barre de don fixe en bas de l'écran mobile (page don). */
  masquerDock?: boolean;
}

const { titre, description, masquerDock = false, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://amaafe.org');
const urlCanonique = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/images/logo-amaafe.png', site).href;
const chemin = Astro.url.pathname;

const campagneActive = (config.campagnes ?? []).some((c) => c.active);
const menu = [
  { href: '/le-centre/', label: 'Le centre' },
  { href: '/notre-projet/', label: 'Notre projet' },
  { href: '/parrainage/', label: 'Parrainage' },
  { href: '/l-amaafe/', label: "L'AMAAFE" },
  // L'entrée Campagne n'apparaît que lorsqu'une campagne est active.
  ...(campagneActive ? [{ href: '/campagne/', label: 'Campagne', camp: true }] : []),
  { href: '/actualites/', label: 'Actualités' },
  { href: '/contact/', label: 'Contact' },
];
const estActif = (href: string) =>
  chemin === href || (href !== '/' && chemin.startsWith(href));

const reseaux = [
  ['Facebook', config.reseaux.facebook],
  ['Instagram', config.reseaux.instagram],
  ['WhatsApp', config.reseaux.whatsapp],
  ['YouTube', config.reseaux.youtube],
  ['TikTok', config.reseaux.tiktok],
].filter(([, url]) => url) as [string, string][];

/* Icônes des réseaux pour le panneau du menu mobile. */
const ICONES_RS: Record<string, string> = {
  Facebook: 'M13.5 21.5v-7.2h2.4l.4-2.8h-2.8V9.7c0-.8.3-1.4 1.5-1.4h1.4V5.8c-.3 0-1.2-.1-2.1-.1-2.1 0-3.5 1.3-3.5 3.6v2.2H8.4v2.8h2.4v7.2h2.7Z',
  Instagram: 'M12 8.2a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Zm0 6.3a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Zm4.9-6.4a.9.9 0 1 1-1.8 0 .9.9 0 0 1 1.8 0ZM12 5.4c2.1 0 2.4 0 3.3.1.8 0 1.3.2 1.6.3.4.2.7.3 1 .6.3.3.5.6.6 1 .1.3.3.8.3 1.6.1.9.1 1.2.1 3.3s0 2.4-.1 3.3c0 .8-.2 1.3-.3 1.6-.2.4-.3.7-.6 1-.3.3-.6.5-1 .6-.3.1-.8.3-1.6.3-.9.1-1.2.1-3.3.1s-2.4 0-3.3-.1c-.8 0-1.3-.2-1.6-.3a2.7 2.7 0 0 1-1-.6 2.7 2.7 0 0 1-.6-1c-.1-.3-.3-.8-.3-1.6-.1-.9-.1-1.2-.1-3.3s0-2.4.1-3.3c0-.8.2-1.3.3-1.6.2-.4.3-.7.6-1 .3-.3.6-.5 1-.6.3-.1.8-.3 1.6-.3.9-.1 1.2-.1 3.3-.1Zm0-1.5c-2.2 0-2.4 0-3.3.1-.9 0-1.5.2-2 .4-.6.2-1 .5-1.5 1-.5.5-.8.9-1 1.5-.2.5-.4 1.1-.4 2-.1.9-.1 1.1-.1 3.3s0 2.4.1 3.3c0 .9.2 1.5.4 2 .2.6.5 1 1 1.5.5.5.9.8 1.5 1 .5.2 1.1.4 2 .4.9.1 1.1.1 3.3.1s2.4 0 3.3-.1c.9 0 1.5-.2 2-.4.6-.2 1-.5 1.5-1 .5-.5.8-.9 1-1.5.2-.5.4-1.1.4-2 .1-.9.1-1.1.1-3.3s0-2.4-.1-3.3c0-.9-.2-1.5-.4-2-.2-.6-.5-1-1-1.5-.5-.5-.9-.8-1.5-1-.5-.2-1.1-.4-2-.4-.9-.1-1.1-.1-3.3-.1Z',
  TikTok: 'M17 5.9c-.9-.6-1.6-1.6-1.7-2.9h-3v11.9a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V9.3a5.6 5.6 0 1 0 4.8 5.5V9.4c1 .7 2.3 1.2 3.7 1.2v-3c-.7 0-1.5-.3-2-.7Z',
  WhatsApp: 'M12 3.5a8.4 8.4 0 0 0-7.3 12.7L3.5 20l3.9-1.2A8.4 8.4 0 1 0 12 3.5Zm0 15.3c-1.3 0-2.6-.4-3.7-1l-.3-.2-2.3.7.7-2.2-.2-.3a6.9 6.9 0 1 1 5.8 3Zm3.8-5.1c-.2-.1-1.2-.6-1.4-.7-.2-.1-.3-.1-.5.1-.1.2-.5.7-.6.8-.1.1-.2.1-.4 0a5.6 5.6 0 0 1-2.8-2.4c-.2-.4.2-.3.6-1.1.1-.1 0-.3 0-.4l-.6-1.5c-.2-.4-.3-.3-.5-.3h-.4c-.1 0-.4.1-.6.3-.2.2-.7.7-.7 1.8s.8 2.1.9 2.2c.1.1 1.5 2.3 3.7 3.3 1.4.6 1.9.6 2.6.5.4-.1 1.2-.5 1.4-1 .2-.5.2-.9.1-1 0-.1-.2-.2-.4-.3Z',
  YouTube: 'M20.6 7.7a2.3 2.3 0 0 0-1.6-1.6C17.6 5.7 12 5.7 12 5.7s-5.6 0-7 .4A2.3 2.3 0 0 0 3.4 7.7C3 9.1 3 12 3 12s0 2.9.4 4.3c.2.8.8 1.4 1.6 1.6 1.4.4 7 .4 7 .4s5.6 0 7-.4a2.3 2.3 0 0 0 1.6-1.6c.4-1.4.4-4.3.4-4.3s0-2.9-.4-4.3ZM10.2 14.6V9.4l4.7 2.6-4.7 2.6Z',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: config.site.nom,
  slogan: config.site.devise,
  foundingDate: String(config.site.anneeCreation),
  url: site.href,
  logo: ogImage,
  email: config.contact.email,
  telephone: [config.contact.telMali, config.contact.telFrance],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Yirimadio',
    addressLocality: 'Bamako',
    addressCountry: 'ML',
  },
  parentOrganization: {
    '@type': 'NGO',
    name: config.amaafe.nomComplet,
    alternateName: config.amaafe.sigle,
    slogan: config.amaafe.slogan,
  },
};
---
<!DOCTYPE html>
<html lang="fr" class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titre}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={urlCanonique} />
  <link rel="icon" href="/images/logo-amaafe.png" type="image/png" />
  <link rel="preload" href="/fonts/karla-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/fraunces-600.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={config.site.nom} />
  <meta property="og:title" content={titre} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={urlCanonique} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="fr_FR" />
  <meta name="twitter:card" content="summary" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>

  <div class="topbar">
    <div class="wrap topbar__i">
      <span>{config.site.lieu} &nbsp;·&nbsp; Une initiative de l'<b>{config.amaafe.sigle}</b></span>
      <span>{config.contact.telMali} &nbsp;·&nbsp; {config.contact.telFrance} &nbsp;·&nbsp; {config.contact.email_amaafe} &nbsp;·&nbsp; {config.contact.email}</span>
    </div>
  </div>

  <header class="nav" id="nav">
    <div class="wrap nav__bar">
      <a class="brand" href="/">
        <img class="mark-img" src="/images/logo-amaafe.png" alt="" width="220" height="220" />
        <span>
          <span class="brand__n">{config.amaafe.nomComplet}</span>
        </span>
      </a>
      <nav class="menu" aria-label="Navigation principale">
        {menu.map((item) => (
          <a href={item.href} class:list={[{ camp: item.camp }]} aria-current={estActif(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <div class="nav__cta">
        <a class="btn btn--ghost" href="/parrainage/">Parrainer</a>
        <a class="btn btn--or" href="/faire-un-don/">Faire un don</a>
        <button class="burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mmenu"><span></span><span></span><span></span></button>
      </div>
    </div>
  </header>

    <div class="mvoile" id="mvoile" aria-hidden="true"></div>
    <nav class="mmenu" id="mmenu" aria-label="Navigation mobile">
      <div class="mmenu__h">
        <span><b>{config.site.nom}</b><span class="mmenu__dev">{config.site.devise}</span></span>
        <button type="button" class="mmenu__x" id="mmenu-x" aria-label="Fermer le menu">✕</button>
      </div>
      <div class="mmenu__nav">
        <a href="/" class:list={[{ actif: chemin === '/' }]}>Accueil</a>
        <a href="/le-centre/" class:list={[{ actif: estActif('/le-centre/') }]}>Le centre<span class="fl" aria-hidden="true">›</span></a>
        <a href="/notre-projet/" class:list={[{ actif: estActif('/notre-projet/') }]}>Notre projet<span class="fl" aria-hidden="true">›</span></a>
        <a href="/parrainage/" class:list={[{ actif: estActif('/parrainage/') }]}>Parrainage<span class="fl" aria-hidden="true">›</span></a>
        {campagneActive && (
          <a href="/campagne/" class="camp" class:list={[{ actif: estActif('/campagne/') }]}><i aria-hidden="true"></i>Campagne<span class="badge">En cours</span></a>
        )}
        <span class="mmenu__sep">L'association</span>
        <a href="/l-amaafe/" class:list={[{ actif: estActif('/l-amaafe/') }]}>L'AMAAFE<span class="fl" aria-hidden="true">›</span></a>
        <a href="/transparence/" class:list={[{ actif: estActif('/transparence/') }]}>Transparence<span class="fl" aria-hidden="true">›</span></a>
        <a href="/actualites/" class:list={[{ actif: estActif('/actualites/') }]}>Actualités<span class="fl" aria-hidden="true">›</span></a>
        <a href="/contact/" class:list={[{ actif: estActif('/contact/') }]}>Contact<span class="fl" aria-hidden="true">›</span></a>
      </div>
      <div class="mmenu__pied">
        <div class="mmenu__cta">
          <a class="ghost" href="/parrainage/">Parrainer</a>
          <a class="plein" href="/faire-un-don/">Faire un don</a>
        </div>
        {reseaux.length > 0 && (
          <div class="mmenu__rs">
            {reseaux.map(([nom, url]) => (
              <a href={url} rel="noopener" target="_blank" aria-label={nom}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONES_RS[nom]} /></svg>
              </a>
            ))}
          </div>
        )}
        <div class="mmenu__tel">{config.contact.telMali} · {config.contact.telFrance}</div>
      </div>
    </nav>


  <main id="contenu">
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap">
      <div class="foot__g">
        <div>
          <div class="brand">
            <img class="mark-img" src="/images/logo-amaafe.png" alt="" width="220" height="220" />
            <span><span class="brand__n">CENTRE CORANIQUE RAHMA</span><span class="brand__s">{config.site.devise}</span></span>
          </div>
          <p class="foot__d">Un établissement d'éducation et de formation créé en {config.site.anneeCreation} à Yirimadio, Bamako, à l'initiative de l'AMAAFE.</p>
          <div class="foot__c">
            <span>{config.contact.adresse}</span>
            <span>{config.contact.telMali} · {config.contact.telFrance}</span>
            <span>{config.contact.email}</span>
          </div>
          {reseaux.length > 0 && (
            <div class="foot__s">
              {reseaux.map(([nom, url]) => <a href={url} rel="noopener">{nom}</a>)}
            </div>
          )}
        </div>
        <div class="foot__col">
          <b>Le centre</b>
          <a href="/le-centre/">Qui sommes-nous</a>
          <a href="/le-centre/#vision">Notre vision</a>
          <a href="/notre-projet/">Le projet de médersa</a>
          <a href="/actualites/">Actualités</a>
        </div>
        <div class="foot__col">
          <b>Soutenir</b>
          <a href="/faire-un-don/">Faire un don</a>
          <a href="/parrainage/">Parrainer un enfant</a>
          <a href="/contact/">Devenir bénévole</a>
          <a href="/contact/">Partenariats</a>
        </div>
        <div class="foot__col">
          <b>L'association</b>
          <a href="/l-amaafe/">L'AMAAFE</a>
          <a href="/transparence/">Transparence</a>
          <a href="/mentions-legales/">Mentions légales</a>
          <a href="/contact/">Nous contacter</a>
        </div>
      </div>
      <div class="legal">
        <strong style="color:rgba(255,255,255,.8)">Mentions légales —</strong>
        Site édité par l'{config.amaafe.nomComplet} ({config.amaafe.sigle}).
        {config.entites.mali.nom} : association déclarée le {config.entites.mali.dateCreation}, {config.entites.mali.reference.toLowerCase()}, siège social à {config.entites.mali.siege}.
        {config.entites.france.nom} : association loi 1901 déclarée le {config.entites.france.dateCreation}, {config.entites.france.reference.toLowerCase()}, siège social à {config.entites.france.siege}.
        Directrice de la publication : {config.dirigeants.presidente}, présidente de l'association. Hébergeur : Cloudflare, Inc., 101 Townsend Street, San Francisco, CA 94107, États-Unis.
        <div class="legal__b">
          <span>© 2026 {config.site.nom} — {config.amaafe.sigle}. Tous droits réservés.</span>
          <div>
            <a href="/mentions-legales/">Mentions légales</a>
            <a href="/confidentialite/">Politique de confidentialité</a>
            <a href="/conditions-de-don/">Conditions de don</a>
            <a href="/admin/tableau-de-bord/" rel="nofollow">Accès admin</a>
          </div>
        </div>
      </div>
    </div>
  </footer>

  {!masquerDock && (
    <div class="dock">
      <a class="btn btn--ghost" href="/parrainage/">Parrainer</a>
      <a class="btn btn--or" href="/faire-un-don/">Faire un don</a>
    </div>
  )}

  <Assistant />

  <script is:inline defer src="/js/site.js"></script>
  <script is:inline defer src="/js/collecte.js"></script>
</body>
</html>
