---
/** Grille des enfants à parrainer (maquette validée) : les 4 premiers
    enfants en attente d'abord, le reste (en attente, puis parrainés en fin
    de liste) révélé sur place par un bouton. Tri par matricule, filtres
    Tous / Filles / Garçons / Déjà parrainés. */
import { getCollection } from 'astro:content';
import CarteEnfant from './CarteEnfant.astro';

const { lien = '/parrainage/#devenir-parrain', id = 'enfants' } = Astro.props;

const tous = (await getCollection('enfants', ({ data }) => data.publie))
  .sort((a, b) => (a.data.matricule ?? a.id).localeCompare(b.data.matricule ?? b.id));
const attente = tous.filter((e) => !e.data.parraine);
const parraines = tous.filter((e) => e.data.parraine);
const apercu = attente.slice(0, 4);
const suite = [...attente.slice(4), ...parraines];
const nbFilles = tous.filter((e) => e.data.sexe === 'fille').length;
const nbGarcons = tous.filter((e) => e.data.sexe === 'garcon').length;
const libelle = [
  attente.length > 4 ? `${attente.length - 4} en attente` : null,
  parraines.length > 0 ? `${parraines.length} parrainé${parraines.length > 1 ? 's' : ''}` : null,
].filter(Boolean).join(' et ');
---
{tous.length > 4 && (
  <div class="filtres rv" role="group" aria-label="Filtrer les enfants" data-filtres={id}>
    <button type="button" class="actif" data-filtre="tous">Tous ({tous.length})</button>
    {nbFilles > 0 && <button type="button" data-filtre="fille">Filles ({nbFilles})</button>}
    {nbGarcons > 0 && <button type="button" data-filtre="garcon">Garçons ({nbGarcons})</button>}
    {parraines.length > 0 && <button type="button" data-filtre="parraine">Déjà parrainés ({parraines.length})</button>}
  </div>
)}
<div class="g4" id={`${id}-apercu`}>
  {apercu.map((enfant) => <CarteEnfant enfant={enfant} lien={lien} />)}
</div>
{suite.length > 0 && (
  <Fragment>
    <div class="g4" id={`${id}-suite`} hidden style="margin-top:20px">
      {suite.map((enfant) => <CarteEnfant enfant={enfant} lien={lien} />)}
    </div>
    <div class="voirplus rv">
      <button type="button" class="btn btn--ghost btn--lg" data-voirplus={`${id}-suite`}
        aria-expanded="false" aria-controls={`${id}-suite`}>Voir les autres enfants — {libelle} ↓</button>
    </div>
    <script is:inline>
      (function () {
        function revele(idSuite) {
          var suite = document.getElementById(idSuite);
          if (suite) {
            suite.hidden = false;
            suite.querySelectorAll('.rv').forEach(function (el) { el.classList.add('is-in'); });
          }
          var vp = document.querySelector('[data-voirplus="' + idSuite + '"]');
          if (vp) vp.closest('.voirplus').hidden = true;
        }
        document.querySelectorAll('[data-voirplus]').forEach(function (b) {
          if (b.dataset.vpInit) return;
          b.dataset.vpInit = '1';
          b.addEventListener('click', function () {
            revele(b.dataset.voirplus);
            b.setAttribute('aria-expanded', 'true');
          });
        });
        document.querySelectorAll('[data-filtres]').forEach(function (bar) {
          if (bar.dataset.fInit) return;
          bar.dataset.fInit = '1';
          var base = bar.dataset.filtres;
          bar.querySelectorAll('button').forEach(function (btn) {
            btn.addEventListener('click', function () {
              bar.querySelectorAll('button').forEach(function (x) { x.classList.toggle('actif', x === btn); });
              revele(base + '-suite');
              var f = btn.dataset.filtre;
              document.querySelectorAll('#' + base + '-apercu .cenf, #' + base + '-suite .cenf').forEach(function (c) {
                var ok = f === 'tous' || (f === 'parraine' ? c.dataset.parraine === '1' : c.dataset.sexe === f);
                c.style.display = ok ? '' : 'none';
              });
            });
          });
        });
      })();
    </script>
  </Fragment>
)}
