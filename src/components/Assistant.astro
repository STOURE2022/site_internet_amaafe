---
/** Assistant Rahma : chatbot guidé, sans serveur ni IA — bulle flottante
    et fenêtre de discussion présentes sur toutes les pages publiques
    (inclus par le layout Base). Les réponses sont construites par
    /public/js/assistant.js à partir des données injectées ci-dessous,
    donc toujours alignées sur la configuration admin. */
import { getCollection } from 'astro:content';
import config from '../../content/config.json';
import { pourcentageCollecte } from '../lib/format.js';
import { lireDocumentsDetail, fmtTaille, NOMS_DOCUMENTS } from '../lib/admin.js';

const actus = await getCollection('actualites', ({ data }) => data.publie);
const derniereActu = [...actus].sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''))[0];
const documents = lireDocumentsDetail().map((d) => ({
  titre: NOMS_DOCUMENTS[d.nom] ?? `📄 ${d.nom.replace(/\.pdf$/, '').replace(/-/g, ' ')}`,
  href: d.href,
  taille: fmtTaille(d.taille),
}));

const cfg = {
  waMali: config.whatsapp.numeroMali,
  waFrance: config.whatsapp.numeroFrance,
  waParrainage: config.whatsapp.numeroParrainage || config.whatsapp.numeroMali || config.whatsapp.numeroFrance,
  telMali: config.contact.telMali,
  telFrance: config.contact.telFrance,
  email: config.contact.email,
  horaires: config.contact.horairesVisite,
  adresse: config.contact.adresse,
  eleves: config.chiffres.enfants,
  enseignants: config.chiffres.enseignants,
  anneeCreation: config.site.anneeCreation,
  parrainageFCFA: config.parrainage.montantMensuelFCFA,
  parrainageEUR: config.parrainage.montantMensuelEUR,
  suiviJusquaAge: config.chiffres.suiviJusquaAge,
  objectifEUR: config.medersa.budgetTotalEUR,
  collecteFCFA: config.medersa.montantCollecteFCFA,
  pctCollecte: pourcentageCollecte(config.medersa),
  reseaux: config.reseaux,
  documents: documents,
  derniereActu: derniereActu ? derniereActu.data.titre : null,
  benevoles: config.chiffres.benevoles,
  membresAdherents: config.chiffres.membresAdherents,
};
---
<div class="cb-coucou" id="cb-coucou" hidden aria-hidden="true">
  <span id="cb-coucou-txt">Assalamu alaykum 👋 Je peux vous aider</span>
</div>

<button type="button" class="cb-bulle" id="cb-ouvre" aria-expanded="false" aria-controls="cb" aria-label="Ouvrir l'assistant du Centre Rahma">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
    <linearGradient id="feu-cb" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#B3271E" /><stop offset=".55" stop-color="#D9A62B" /><stop offset="1" stop-color="#F3C75C" />
    </linearGradient>
  </defs></svg>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3C7 3 3 6.6 3 11c0 2.2 1 4.2 2.7 5.6-.1 1-.5 2.1-1.4 3.1-.2.2 0 .6.3.5 1.7-.2 3.1-.8 4.1-1.5 1 .3 2.1.4 3.3.4 5 0 9-3.6 9-8S17 3 12 3Zm-4.2 9.3a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Zm4.2 0a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Zm4.2 0a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Z" /></svg>
  <svg class="cb-flamme" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c.8 2.8-1.2 4-1.2 6a3.1 3.1 0 0 0 6.2.3c1.5 1.6 3 3.6 3 6A8 8 0 1 1 5 13.6c0 1.9 1 3.1 2.1 3.6C6.3 12.6 9.4 6.9 12 2.2Z" /></svg>
</button>

<div class="cb" id="cb" role="dialog" aria-modal="false" aria-label="Assistant du Centre Rahma" hidden>
  <div class="cb__h">
    <span class="cb__av">
      <svg viewBox="0 0 48 48" aria-hidden="true"><g fill="none" stroke="#0A1B12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M24 12c-3.4-2.8-8.2-3.6-14-3v26c5.8-.6 10.6.2 14 3 3.4-2.8 8.2-3.6 14-3V9c-5.8-.6-10.6.2-14 3Z" fill="#FCFAF5" />
        <line x1="24" y1="12" x2="24" y2="38" />
        <path d="M14 16.5c2.4-.2 4.6 0 6.5.6M14 22c2.4-.2 4.6 0 6.5.6M14 27.5c2.4-.2 4.6 0 6.5.6M27.5 17.1c1.9-.6 4.1-.8 6.5-.6M27.5 22.6c1.9-.6 4.1-.8 6.5-.6M27.5 28.1c1.9-.6 4.1-.8 6.5-.6" stroke-width="1.9" />
      </g></svg>
      <i aria-hidden="true"></i>
    </span>
    <div><b>Assistant Rahma</b><span>Répond tout de suite · français</span></div>
    <button type="button" class="cb__x" id="cb-ferme" aria-label="Fermer l'assistant">✕</button>
  </div>
  <div class="cb__flux" id="cb-flux"></div>
  <div class="cb__pied">Assistant automatique — pour une vraie personne : WhatsApp {cfg.telMali}</div>
</div>

<script type="application/json" id="assistant-config" set:html={JSON.stringify(cfg)} />
<script is:inline defer src="/js/assistant.js"></script>
