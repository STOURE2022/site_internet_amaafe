---
/** Bloc e-mail sans système d'envoi : l'adresse est visible et copiable,
    le message est prêt à copier, et « ouvrir l'application e-mail » n'est
    qu'une option — jamais le seul chemin (elle échoue en silence quand
    aucune application n'est configurée). Les boutons Copier sont gérés
    par délégation dans public/js/site.js. */
import config from '../../content/config.json';

const { objet, message, libelle = 'Message à envoyer', aide = true } = Astro.props;
const email = config.contact.email;
const s = encodeURIComponent(objet);
const c = encodeURIComponent(message);
const d = encodeURIComponent(email);
const lienGmail = `https://mail.google.com/mail/?view=cm&fs=1&to=${d}&su=${s}&body=${c}`;
const lienOutlook = `https://outlook.live.com/mail/0/deeplink/compose?to=${d}&subject=${s}&body=${c}`;
const lienYahoo = `https://compose.mail.yahoo.com/?to=${d}&subject=${s}&body=${c}`;
const mailto = `mailto:${email}?subject=${s}&body=${c}`;
---
<div class="bmail">
  <div class="bmail__adr">
    <b>À&nbsp;:</b><span>{email}</span>
    <button type="button" class="bmail__copier" data-copie={email}>Copier</button>
  </div>
  <div class="bmail__msg">
    <b>{libelle}</b>
    <pre>Objet : {objet}

{message}</pre>
  </div>
  <div class="bmail__act">
    <button type="button" class="btn btn--ghost" data-copie-bloc>Copier le message</button>
    <a class="btn btn--or" href={lienGmail} target="_blank" rel="noopener">Ouvrir dans Gmail</a>
  </div>
  <div class="bmail__autres">Ou ouvrir dans :
    <a href={lienOutlook} target="_blank" rel="noopener">Outlook</a> ·
    <a href={lienYahoo} target="_blank" rel="noopener">Yahoo</a> ·
    <a href={mailto}>l'application de l'appareil</a>
  </div>
</div>
{aide && (
  <p class="bmail__aide">Gmail, Outlook et Yahoo s'ouvrent dans le navigateur, avec le message déjà écrit — connectez-vous à votre boîte si nécessaire.</p>
)}
