---
/** Bloc don de la page d'accueil : choix du montant, de la devise et du
    canal, aperçu des instructions, puis renvoi vers /faire-un-don pour
    la déclaration. Le JS associé est /public/js/don.js (via DonConfig). */
import config from '../../content/config.json';
import { fmtNombre } from '../lib/format.js';
import Fiabilite from './Fiabilite.astro';
---
<section class="sec give" id="don">
  <div class="wrap give__g">
    <div class="rv">
      <span class="eyebrow">Faire un don</span>
      <h2 style="margin-top:15px">Votre don devient un cartable, un uniforme, une salle de classe.</h2>
      <p class="lead give__l">Le centre ne demande rien aux familles. Tout repose sur la générosité des donateurs qui nous soutiennent au Mali et partout dans le monde.</p>
      <div class="impact">
        <span class="impact__k">Ce que votre don finance</span>
        <p class="impact__v" id="impactText">Donnez <b>10 000 FCFA</b> et vous financez <b>une part concrète</b> de la scolarité d'un enfant.</p>
        <p class="impact__n" id="impactNote">Base : {fmtNombre(config.chiffres.coutMensuelParEnfantFCFA)} FCFA par mois et par enfant, soit {fmtNombre(config.chiffres.coutAnnuelParEnfantFCFA)} FCFA par an — scolarité, fournitures et accompagnement.</p>
      </div>
      <p class="give__n"><span aria-hidden="true">✳</span> Les comptes du centre seront publiés régulièrement. L'association française dispose d'un rescrit fiscal : les dons versés en France ouvrent droit à une réduction d'impôt.</p>
    </div>

    <div class="form rv">
      <h3 style="font-size:22px">Soutenir le Centre Rahma</h3>
      <p class="form__s">Sécurisé · 2 minutes · sans création de compte</p>

      <div class="toggle" role="group" aria-label="Fréquence du don">
        <button type="button" data-freq="once" aria-pressed="true">Don ponctuel</button>
        <button type="button" data-freq="month" aria-pressed="false">Don mensuel</button>
      </div>

      <span class="fl" id="lbl-devise">Devise</span>
      <div class="toggle toggle--3" style="margin-top:0" role="group" aria-labelledby="lbl-devise">
        <button type="button" data-cur="FCFA" aria-pressed="true">FCFA</button>
        <button type="button" data-cur="EUR" aria-pressed="false">Euro</button>
        <button type="button" data-cur="USD" aria-pressed="false">Dollar</button>
      </div>

      <span class="fl" id="lbl-montant">Choisissez un montant</span>
      <div class="amts" role="group" aria-labelledby="lbl-montant" id="amts"></div>

      <label class="fl" for="custom">Ou saisissez un autre montant</label>
      <div class="input"><input id="custom" type="number" min="1" placeholder="Montant libre" inputmode="numeric"><span id="curLabel">FCFA</span></div>

      <span class="fl" id="lbl-canal">Moyen de paiement</span>
      <div class="pays" role="group" aria-labelledby="lbl-canal" id="pays">
        <button type="button" class="pay" data-pay="om" aria-pressed="true"><i style="background:#F26522"></i>Orange Money</button>
        <button type="button" class="pay" data-pay="wave" aria-pressed="false"><i style="background:#1DC3F0"></i>Wave</button>
        <button type="button" class="pay" data-pay="vir-ml" aria-pressed="false"><i style="background:#0F4A2F"></i>Virement Mali</button>
        <button type="button" class="pay" data-pay="vir-fr" aria-pressed="false"><i style="background:#D9A62B"></i>Virement France</button>
        <button type="button" class="pay" data-pay="wero" aria-pressed="false"><i style="background:#7A5CF0"></i>Wero (Europe)</button>
        <button type="button" class="pay" data-pay="paypal" aria-pressed="false"><i style="background:#003087"></i>PayPal</button>
        <button type="button" class="pay" data-pay="helloasso" aria-pressed="false"><i style="background:#46BE8A"></i>HelloAsso (CB)</button>
      </div>

      <div class="paybox" id="paybox"></div>

      <label class="anon anon--mini" for="don-anon">
        <input type="checkbox" id="don-anon">
        <span><b>🕶️ Je souhaite rester anonyme</b><p>Votre nom ne sera pas demandé à la déclaration.</p></span>
      </label>

      <a class="btn btn--or btn--full btn--lg" id="versDeclaration" href="/faire-un-don/#declarer">J'ai envoyé mon don — je le déclare</a>
      <Fiabilite />
    </div>
  </div>
</section>
