---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { fmtDate } from '../../lib/format.js';

export async function getStaticPaths() {
  const articles = await getCollection('actualites', ({ data }) => data.publie);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---
<Base
  titre={`${article.data.titre} | Centre Coranique Rahma`}
  description={article.data.extrait}
>

  <article class="sec" style="padding-top:clamp(36px,5vw,64px)">
    <div class="wrap" style="max-width:860px">
      <div class="rv">
        <div class="art__m">
          <i>{article.data.categorie}</i>
          {article.data.date
            ? <span>{fmtDate(article.data.date)}</span>
            : <span class="tbd">date à préciser</span>}
        </div>
        <h1 style="color:var(--vert);font-size:clamp(30px,4vw,46px)">{article.data.titre}</h1>
        {article.data.image
          ? <img class="art__img" src={article.data.image} alt="" width="1200" height="675" />
          : <div class="photo photo--p" style="aspect-ratio:16/9;margin-top:28px">Photo — {article.data.titre}</div>}
        <div class="prose">
          <Content />
        </div>
        <div style="margin-top:40px;display:flex;gap:12px;flex-wrap:wrap">
          <a class="btn btn--ghost" href="/actualites/">← Toutes les actualités</a>
          <a class="btn btn--or" href="/faire-un-don/">Soutenir le centre</a>
        </div>
      </div>
    </div>
  </article>

</Base>
