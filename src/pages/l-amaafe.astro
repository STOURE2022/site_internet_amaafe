---
import Base from '../layouts/Base.astro';
import config from '../../content/config.json';
import { getCollection, render } from 'astro:content';

const { mali, france } = config.entites;
const temoignages = (await getCollection('temoignages', ({ data }) => data.publie && data.contexte === 'amaafe'))
  .sort((a, b) => a.data.ordre - b.data.ordre);
const temoignagesRendus = await Promise.all(
  temoignages.map(async (t) => ({ ...t, Contenu: (await render(t)).Content }))
);
---
<Base
  titre="L'AMAAFE — L'association qui porte le Centre Rahma"
  description="L'Association Malienne d'Aide et d'Accompagnement de la Femme et de l'Enfant (AMAAFE) agit depuis 2010 pour les femmes et les enfants au Mali. Elle porte le Centre Coranique Rahma."
>

  <section class="wrap phero">
    <span class="eyebrow eyebrow--d">L'association porteuse</span>
    <h1>{config.amaafe.slogan}</h1>
    <p class="lead">L'{config.amaafe.nomComplet} ({config.amaafe.sigle}) est une association à but non lucratif et apolitique, née du constat des conditions de vie des femmes et des enfants au Mali. Elle est reconnue légalement au Mali et en France.</p>
    <div class="tags">
      {config.amaafe.valeurs.map((valeur) => <span class="tag">{valeur}</span>)}
    </div>
  </section>

  <!-- ===== PRÉSENTATION + DOMAINES ===== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap about">
      <div class="rv">
        <img class="logo-amaafe" src="/images/logo-amaafe.png" alt={`Logo de l'AMAAFE — ${config.amaafe.slogan}`} width="220" height="220" style="width:160px" loading="lazy" />
        <h2 style="margin-top:20px;color:var(--vert)">Le Centre Rahma n'est qu'une de ses actions</h2>
        <hr class="rule">
        <p class="lead">Depuis sa création au Mali en 2010, puis en France en 2012, l'AMAAFE intervient auprès des femmes et des enfants sur douze domaines d'action :</p>
        <div class="tags">
          {config.amaafe.domainesAction.map((domaine) => <span class="tag">{domaine}</span>)}
        </div>
      </div>
      <div class="gal rv">
        <div class="photo photo--s">Photo — une action de sensibilisation</div>
        <div class="photo photo--p">Photo — l'équipe AMAAFE</div>
        <div class="photo photo--p">Photo — une sortie éducative</div>
      </div>
    </div>
  </section>

  <!-- ===== NOTRE HISTOIRE + BUREAU ===== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap about">
      <div class="rv">
        <span class="eyebrow eyebrow--d">Notre histoire</span>
        <h2 style="margin-top:14px">Une histoire de solidarité</h2>
        <hr class="rule">
        <p class="lead">L'histoire de l'AMAAFE est avant tout celle d'hommes et de femmes qui ont refusé de rester indifférents face aux difficultés des populations les plus fragiles.</p>
        <p style="font-size:15px;color:var(--gris);line-height:1.7;margin-top:14px">Au début des années 2010, les membres fondateurs, autour de {config.dirigeants.fondatrice}, constatent que de nombreuses familles font face à des difficultés majeures : accès limité aux soins, précarité économique, faible accès à l'éducation, manque d'eau potable, insuffisance de soutien aux femmes et aux enfants. Ils décident de créer une organisation capable d'apporter des réponses concrètes, durables et adaptées : l'AMAAFE est née.</p>
        <p style="font-size:15px;color:var(--gris);line-height:1.7;margin-top:12px">L'année 2023 marque une étape importante avec la création du Centre Rahma, un projet éducatif destiné à offrir gratuitement une éducation à des enfants issus de familles défavorisées — en joignant l'aspect spirituel à l'action humanitaire, ce qui fait la singularité de l'association.</p>
        <p style="font-size:15px;color:var(--gris);line-height:1.7;margin-top:12px">L'association intervient aujourd'hui à {config.amaafe.zoneIntervention}, et s'appuie sur {config.chiffres.membresAdherents} membres adhérents et {config.chiffres.benevoles} bénévoles actifs.</p>
      </div>
      <div class="rv">
        <div class="card entity">
          <div class="entity__t">Le bureau de l'association</div>
          <div class="dl" style="margin-top:14px">
            <div><em>Fondatrice &amp; présidente</em><span>{config.dirigeants.presidente}</span></div>
            <div><em>Vice-présidente</em><span>{config.dirigeants.vicePresidente}</span></div>
            <div><em>Secrétaire général</em><span>{config.dirigeants.secretaireGeneral}</span></div>
            <div><em>Trésorier</em><span>{config.dirigeants.tresorier}</span></div>
            <div><em>Communication</em><span>{config.dirigeants.responsablesCommunication.join(' · ')}</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== RÉALISATIONS DEPUIS 2010 ===== -->
  <section class="sec" style="background:var(--blanc);border-block:1px solid var(--ligne)">
    <div class="wrap">
      <div class="head rv">
        <div>
          <span class="eyebrow eyebrow--d">Nos réalisations</span>
          <h2>Quinze ans d'action, des résultats concrets</h2>
        </div>
        <p class="lead" style="max-width:40ch">Chiffres issus du <a href="/documents/rapport-impact-2010-2025.pdf" style="color:var(--vert);text-decoration:underline">rapport d'impact 2010-2025</a> de l'association.</p>
      </div>
      <div class="g3">
        {config.impact.realisations.map((r) => (
          <div class="card rv" style="padding:24px 24px 22px">
            <b class="num" style="font-family:var(--serif);font-size:clamp(30px,3vw,40px);color:var(--vert);line-height:1">{r.valeur}</b>
            <p style="font-size:14px;color:var(--gris);margin-top:10px;line-height:1.6">{r.libelle}</p>
          </div>
        ))}
      </div>
      <div class="rv" style="margin-top:46px">
        <div class="head" style="margin-bottom:0">
          <div>
            <span class="eyebrow eyebrow--d">Perspectives</span>
            <h2>Cap sur 2030</h2>
          </div>
          <p class="lead" style="max-width:40ch">Les priorités que l'association s'est fixées pour les prochaines années.</p>
        </div>
        <div class="eng">
          {config.amaafe.perspectives2030.map((perspective) => (
            <div class="eng__i"><span class="eng__c">✓</span><div><b>{perspective}</b></div></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PARTENAIRES ===== -->
  <section class="sec">
    <div class="wrap">
      <div class="head rv" style="margin-bottom:10px">
        <div>
          <span class="eyebrow eyebrow--d">Ils nous accompagnent</span>
          <h2>Nos partenaires</h2>
        </div>
      </div>
      <div class="partners rv">
        {config.partenaires.map((p) => (
          <div class="partner">
            <img src={p.logo} alt={`Logo ${p.nom}`} loading="lazy" width="130" height="76" />
            <span>{p.nom}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== TÉMOIGNAGES ===== -->
  {temoignagesRendus.length > 0 && (
    <section class="sec" style="background:var(--blanc);border-block:1px solid var(--ligne)">
      <div class="wrap">
        <div class="head rv">
          <div>
            <span class="eyebrow eyebrow--d">Ils en parlent</span>
            <h2>Bénévoles, donateurs et partenaires témoignent</h2>
          </div>
        </div>
        <div class="g3">
          {temoignagesRendus.map((t) => (
            <article class="card quote rv">
              <blockquote><t.Contenu /></blockquote>
              <footer><b>{t.data.nom}</b><span>{t.data.role}</span></footer>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== LES DEUX ENTITÉS ===== -->
  <section class="sec trust">
    <div class="wrap">
      <div class="head rv">
        <div>
          <span class="eyebrow eyebrow--d">Deux entités déclarées</span>
          <h2>Une association, deux ancrages</h2>
        </div>
        <p class="lead" style="max-width:40ch">L'entité malienne agit sur le terrain à Bamako ; l'entité française relaie l'action auprès de la diaspora et des partenaires en Europe.</p>
      </div>
      <div class="g2">
        <div class="card entity rv">
          <div class="entity__t">Entité malienne</div>
          <h3>{mali.nom}</h3>
          <div class="dl">
            <div><em>Date de création</em><span>{mali.dateCreation}</span></div>
            <div><em>Référence</em><span>{mali.reference}</span></div>
            <div><em>Siège social</em><span>{mali.siege}</span></div>
            <div><em>Régime</em><span>{mali.regime}</span></div>
            <div><em>Porte</em><span>Le Centre Rahma</span></div>
          </div>
        </div>
        <div class="card entity rv">
          <div class="entity__t">Entité française</div>
          <h3>{france.nom}</h3>
          <div class="dl">
            <div><em>Date de création</em><span>{france.dateCreation}</span></div>
            <div><em>Référence</em><span>{france.reference}</span></div>
            <div><em>Siège social</em><span>{france.siege}</span></div>
            <div><em>Régime</em><span>{france.regime}</span></div>
            <div><em>Courriel</em><span>{france.email}</span></div>
          </div>
        </div>
      </div>
      <div class="rv" style="margin-top:26px;text-align:center">
        <a class="btn btn--ghost" href="/transparence/">Voir toutes nos références et documents</a>
      </div>
    </div>
  </section>

  <!-- ===== APPEL ===== -->
  <section class="sec">
    <div class="wrap" style="text-align:center">
      <div class="rv">
        <span class="eyebrow eyebrow--d">Agir avec nous</span>
        <h2 style="margin-top:14px;color:var(--vert)">Rejoignez l'action de l'AMAAFE</h2>
        <p class="lead" style="max-width:56ch;margin:18px auto 0">Adhésion, bénévolat, partenariat ou soutien au Centre Rahma : chaque engagement compte.</p>
        <div class="hero__act" style="justify-content:center">
          <a class="btn btn--or btn--lg" href="/faire-un-don/">Soutenir le Centre Rahma</a>
          <a class="btn btn--ghost btn--lg" href="/contact/">Nous contacter</a>
        </div>
      </div>
    </div>
  </section>

</Base>
