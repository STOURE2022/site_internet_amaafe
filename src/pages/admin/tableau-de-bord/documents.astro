---
/** Vue interne des documents téléchargeables : la liste vit dans la
    configuration (admin → section Documents), les PDF sont téléversés
    directement depuis l'éditeur dans public/documents. */
import Admin from '../../../layouts/Admin.astro';
import config from '../../../../content/config.json';
import { lireDocumentsPublies, statutsPublies, fmtTaille, versConfigSection } from '../../../lib/admin.js';

const documents = lireDocumentsPublies(config);
const statutsPresents = statutsPublies(config);
const versDocs = versConfigSection('Documents à télécharger (page Transparence)');
---
<Admin titre="Documents" sousTitre={`${documents.length} PDF téléchargeable${documents.length > 1 ? 's' : ''} sur la page Transparence — gérés depuis l'éditeur, téléversement compris.`} actif="documents">
  <Fragment slot="actions">
    <a class="btn btn--ghost" href="/transparence/">Voir la page publique ↗</a>
    <a class="btn btn--or" href={versDocs}>+ Ajouter un document</a>
  </Fragment>

  <section class="card" style="margin-top:24px">
    <div class="scroll">
      <table class="tbl">
        <thead>
          <tr><th>Document</th><th>Fichier</th><th>Taille</th><th class="act">Actions</th></tr>
        </thead>
        <tbody>
          {documents.map((d) => (
            <tr>
              <td><b>{d.titre}</b>{d.description && <Fragment><br /><span class="muted">{d.description}</span></Fragment>}</td>
              <td class="dt">{(d.href ?? '').split('/').pop()}</td>
              <td class="dt">{d.taille != null ? fmtTaille(d.taille) : <span class="chip chip--off">fichier introuvable</span>}</td>
              <td class="act">
                <a href={d.href} rel="noopener">Voir ↗</a>
                <a href={versDocs}>Modifier →</a>
              </td>
            </tr>
          ))}
          {!statutsPresents && (
            <tr>
              <td><b>Statuts de l'association</b></td>
              <td><span class="chip chip--off">manquant</span></td>
              <td class="dt">—</td>
              <td class="act"><a href={versDocs}>Téléverser →</a></td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </section>

  <p style="font-size:13px;color:var(--gris);margin-top:14px">
    « Ajouter un document » ouvre l'éditeur à la section <strong>Documents à télécharger</strong> : donnez un titre,
    téléversez le PDF, enregistrez — il apparaît sur la page Transparence après le redéploiement (2-3 minutes).
    Compressez les fichiers volumineux avant l'envoi : le site vise les connexions lentes.
  </p>
</Admin>
