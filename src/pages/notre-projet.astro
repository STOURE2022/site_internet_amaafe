---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import config from '../../content/config.json';
import { fmtNombre, pourcentageCollecte, collecteManuelleFCFA } from '../lib/format.js';

/* Parité fixe FCFA/euro : 1 € = 655,957 FCFA */
const pctCollecte = pourcentageCollecte(config.medersa);
const pctCollecteFr = String(pctCollecte).replace('.', ',');
const collecteFCFA = collecteManuelleFCFA(config.medersa);
const objectifFCFA = config.medersa.budgetTotalEUR != null ? Math.round(config.medersa.budgetTotalEUR * 655.957) : null;
const resteFCFA = collecteFCFA != null && objectifFCFA != null ? Math.max(0, objectifFCFA - collecteFCFA) : null;
const resteAffiche = resteFCFA == null
  ? null
  : resteFCFA >= 1e6
    ? `${(resteFCFA / 1e6).toFixed(1).replace('.', ',')} millions FCFA`
    : `${fmtNombre(resteFCFA)} FCFA`;
---
<Base
  titre="Notre projet — Un terrain, puis une médersa | Centre Coranique Rahma"
  description="Le projet prioritaire du Centre Coranique Rahma : acquérir un terrain à Bamako et y construire une médersa avec salles de classe, bibliothèque, sanitaires et espaces de formation professionnelle."
>

  <section class="wrap phero">
    <span class="eyebrow eyebrow--d">Notre projet prioritaire</span>
    <h1>Sortir du hangar et construire une médersa.</h1>
    <p class="lead">Aujourd'hui, les cours se tiennent sous un hangar en tôle, sur une parcelle prêtée par la mosquée du quartier. Notre priorité absolue : acquérir un terrain et y bâtir un vrai centre.</p>
  </section>

  <!-- ===== AVANCEMENT DE LA COLLECTE ===== -->
  <section class="sec" style="padding-top:8px;padding-bottom:clamp(36px,5vw,56px)">
    <div class="wrap">
      <div class="collecte rv" data-collecte data-objectif-fcfa={objectifFCFA ?? 0} data-manuel-fcfa={collecteFCFA ?? 0}>
        <div class="collecte__in">
          <div>
            <span class="collecte__eb">Collecte — terrain de la médersa <span class="clive" data-clive hidden><i></i>Mise à jour auto</span></span>
            {collecteFCFA != null ? (
              <Fragment>
                <div class="collecte__m"><b data-ctotal>{fmtNombre(collecteFCFA)} FCFA</b> collectés</div>
                <p class="collecte__obj">sur un objectif de <strong>{fmtNombre(objectifFCFA)} FCFA</strong> ({fmtNombre(config.medersa.budgetTotalEUR)} €)</p>
                <div class="collecte__jt" role="img" aria-label={`Avancement de la collecte : ${pctCollecteFr} pour cent`}><i data-fill={pctCollecte} data-cbar-m></i><i class="jt-ha" data-cbar-h></i></div>
                <div class="collecte__jf"><span>saisies de l'équipe + HelloAsso</span><b data-cpct>{pctCollecteFr} %</b></div>
                <div class="collecte__det" data-cdet hidden><i></i>dont HelloAsso (carte bancaire), automatique<b data-cdet-mnt></b></div>
                <div class="cmaj" data-cmaj hidden></div>
              </Fragment>
            ) : (
              <Fragment>
                {/* Sans saisie hors ligne, la page est publiée « en préparation » ;
                    si HelloAsso renvoie un montant, collecte.js bascule sur la
                    jauge complète ci-dessous (data-cprep ↔ data-cjauge). */}
                <div data-cprep>
                  <div class="collecte__m">Collecte en <b>préparation</b></div>
                  <p class="collecte__obj">Objectif : <strong>{fmtNombre(objectifFCFA)} FCFA</strong> ({fmtNombre(config.medersa.budgetTotalEUR)} €). Le montant déjà collecté sera publié ici dès les premiers dons.</p>
                </div>
                <div hidden data-cjauge>
                  <div class="collecte__m"><b data-ctotal>0 FCFA</b> collectés</div>
                  <p class="collecte__obj">sur un objectif de <strong>{fmtNombre(objectifFCFA)} FCFA</strong> ({fmtNombre(config.medersa.budgetTotalEUR)} €)</p>
                  <div class="collecte__jt" role="img" aria-label="Avancement de la collecte"><i data-fill={0} data-cbar-m></i><i class="jt-ha" data-cbar-h></i></div>
                  <div class="collecte__jf"><span>saisies de l'équipe + HelloAsso</span><b data-cpct>0 %</b></div>
                  <div class="collecte__det" data-cdet hidden><i></i>dont HelloAsso (carte bancaire), automatique<b data-cdet-mnt></b></div>
                  <div class="cmaj" data-cmaj hidden></div>
                </div>
              </Fragment>
            )}
          </div>
          <div class="collecte__cta">
            {resteAffiche && resteFCFA > 0 && (
              <div class="collecte__reste"><b data-creste>{resteAffiche}</b><span>restent à réunir pour atteindre l'objectif</span></div>
            )}
            {collecteFCFA == null && (
              <div class="collecte__reste" hidden data-cjauge><b data-creste></b><span>restent à réunir pour atteindre l'objectif</span></div>
            )}
            <a class="btn btn--or btn--lg" style="justify-content:center" href="/faire-un-don/">Poser une pierre&nbsp;→</a>
            <p class="collecte__sq">Chaque contribution est une <strong>Sadaqa Jâriya</strong> — une aumône continue.</p>
          </div>
        </div>
      </div>
      <p class="rv" style="font-size:13.5px;color:var(--gris-2);margin-top:14px">L'avancement concret (terrain identifié, achat, début des travaux) sera relaté dans les <a href="/actualites/" style="color:var(--vert);text-decoration:underline">actualités du centre</a>.</p>
    </div>
  </section>

  <!-- ===== LA SITUATION ACTUELLE ===== -->
  <section class="sec chal" style="padding-block:clamp(44px,6vw,80px)">
    <div class="wrap chal__g">
      <div class="rv">
        <span class="eyebrow eyebrow--r">La situation actuelle</span>
        <h2 style="margin-top:15px">URGENTE</h2>
        <p class="lead" style="margin-top:18px;color:rgba(255,255,255,.7)">Les enfants viennent chaque jour, avec courage et motivation. Mais les conditions d'étude restent très difficiles :</p>
        <ul class="chal__l">
          <li><i></i><span>Aucune véritable salle de classe</span></li>
          <li><i></i><span>Chaleur difficilement supportable en saison sèche</span></li>
          <li><i></i><span>Risques réels pendant la saison des pluies</span></li>
          <li><i></i><span>Bruit permanent et inconfort</span></li>
          <li><i></i><span>Manque d'espace et de mobilier adapté</span></li>
        </ul>
      </div>
      <Photo cle="hangar" texte="les cours sous le hangar en tôle" classe="rv" />
    </div>
  </section>

  <!-- ===== LE PROJET EN DÉTAIL ===== -->
  <section class="sec">
    <div class="wrap">
      <div class="head rv">
        <div>
          <span class="eyebrow eyebrow--d">Le projet</span>
          <h2>Une médersa pensée pour les enfants et pour l'avenir</h2>
        </div>
        <p class="lead" style="max-width:40ch">Le projet se déroule en deux temps : d'abord l'acquisition du terrain, ensuite la construction du bâtiment.</p>
      </div>
      <div class="proj rv">
        <div class="proj__b">
          <h3 style="font-size:24px">Les espaces prévus</h3>
          <p class="lead" style="margin-top:14px">La future médersa comprendra tout ce qui manque aujourd'hui aux élèves :</p>
          <div class="rooms">
            <div class="room"><i></i>Des salles de classe</div>
            <div class="room"><i></i>Une salle de mémorisation</div>
            <div class="room"><i></i>Une bibliothèque</div>
            <div class="room"><i></i>Des bureaux administratifs</div>
            <div class="room"><i></i>Des sanitaires</div>
            <div class="room"><i></i>Une cour de récréation</div>
            <div class="room"><i></i>Une salle de prière</div>
            <div class="room"><i></i>Des espaces pour la formation professionnelle</div>
          </div>
          <p class="lead" style="font-size:15px">Ces espaces de formation prépareront la dernière étape du parcours des élèves : l'apprentissage d'un métier à partir de {config.chiffres.ageOrientation} ans.</p>
        </div>
        <div class="proj__side">
          <Photo cle="planMedersa" texte="plan ou vue d'artiste de la future médersa" />
          <p style="font-size:15px;line-height:1.65;color:rgba(255,255,255,.85)">« Chaque contribution, quelle qu'en soit l'importance, représente une pierre supplémentaire vers la réalisation de ce projet. »</p>
          <a class="btn btn--or btn--full" href="/faire-un-don/">Poser une pierre</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== APPEL AU DON ===== -->
  <section class="sec">
    <div class="wrap" style="text-align:center">
      <div class="rv">
        <span class="eyebrow eyebrow--d">Participer</span>
        <h2 style="margin-top:14px;color:var(--vert)">Ce projet se construira pierre par pierre</h2>
        <p class="lead" style="max-width:56ch;margin:18px auto 0">Chaque don, du plus modeste au plus important, rapproche les enfants d'une vraie salle de classe. Les comptes de la collecte seront publiés régulièrement.</p>
        <div class="hero__act" style="justify-content:center">
          <a class="btn btn--or btn--lg" href="/faire-un-don/">Faire un don pour la médersa</a>
          <a class="btn btn--ghost btn--lg" href="/contact/">Proposer un partenariat</a>
        </div>
      </div>
    </div>
  </section>

</Base>
