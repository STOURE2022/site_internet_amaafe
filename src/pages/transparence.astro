---
import Base from '../layouts/Base.astro';
import config from '../../content/config.json';
import { fmtNombre } from '../lib/format.js';
import { lireDocumentsPublies, statutsPublies, fmtTaille } from '../lib/admin.js';

const { mali, france } = config.entites;
const documents = lireDocumentsPublies(config);
const statutsPresents = statutsPublies(config);
---
<Base
  titre="Transparence — Références légales et documents | Centre Coranique Rahma"
  description="Les références légales des deux entités de l'AMAAFE (Mali et France) et les documents de l'association : statuts, rapports d'activité et rapports financiers."
>

  <section class="wrap phero">
    <span class="eyebrow eyebrow--d">Transparence</span>
    <h1>Deux associations déclarées, des comptes ouverts.</h1>
    <p class="lead">La première question d'un donateur n'est pas « combien ? » mais « où va mon argent ? ». Voici nos références, vérifiables, et les documents que nous nous engageons à publier.</p>
  </section>

  <!-- ===== RÉFÉRENCES LÉGALES ===== -->
  <section class="sec trust" style="padding-top:clamp(36px,5vw,60px)">
    <div class="wrap">
      <div class="g2">
        <div class="card entity rv">
          <div class="entity__t">Entité malienne</div>
          <h3>{mali.nom}</h3>
          <div class="dl">
            <div><em>Date de création</em><span>{mali.dateCreation}</span></div>
            <div><em>Référence</em><span>{mali.reference}</span></div>
            <div><em>Siège social</em><span>{mali.siege}</span></div>
            <div><em>Régime</em><span>{mali.regime}</span></div>
            <div><em>Porte</em><span>Le Centre Rahma</span></div>
          </div>
        </div>
        <div class="card entity rv">
          <div class="entity__t">Entité française</div>
          <h3>{france.nom}</h3>
          <div class="dl">
            <div><em>Date de création</em><span>{france.dateCreation}</span></div>
            <div><em>Référence</em><span>{france.reference}</span></div>
            <div><em>Siège social</em><span>{france.siege}</span></div>
            <div><em>Régime</em><span>{france.regime}</span></div>
            <div><em>Courriel</em><span>{france.email}</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== BILAN FINANCIER ===== -->
  <section class="sec">
    <div class="wrap">
      <div class="head rv">
        <div>
          <span class="eyebrow eyebrow--d">Les comptes</span>
          <h2>Bilan financier {config.finances.exercice} — AMAAFE / France</h2>
        </div>
        <p class="lead" style="max-width:42ch">Bilan de l'entité française, établi par le bureau de l'association et présenté aux membres lors de l'assemblée générale ordinaire.</p>
      </div>
      <div class="g3 rv">
        <div class="card entity">
          <div class="entity__t">Recettes</div>
          <b class="num" style="font-family:var(--serif);font-size:clamp(26px,2.6vw,34px);color:var(--vert)">{config.finances.recettesEUR} €</b>
          <p style="font-size:13.5px;color:var(--gris);margin-top:8px">Cotisations, dons, parrainages et événements</p>
        </div>
        <div class="card entity">
          <div class="entity__t">Dépenses</div>
          <b class="num" style="font-family:var(--serif);font-size:clamp(26px,2.6vw,34px);color:var(--vert)">{config.finances.depensesEUR} €</b>
          <p style="font-size:13.5px;color:var(--gris);margin-top:8px">Dont actions humanitaires et fonctionnement du Centre Rahma</p>
        </div>
        <div class="card entity">
          <div class="entity__t">Excédent</div>
          <b class="num" style="font-family:var(--serif);font-size:clamp(26px,2.6vw,34px);color:var(--vert)">{config.finances.excedentEUR} €</b>
          <p style="font-size:13.5px;color:var(--gris);margin-top:8px">Reporté sur l'exercice suivant, au service des projets</p>
        </div>
      </div>
      <div class="g2 rv" style="margin-top:26px">
        <div class="card entity">
          <div class="entity__t">D'où vient l'argent</div>
          <div class="dl" style="margin-top:14px">
            {config.finances.detailRecettes.map((ligne) => (
              <div><em>{ligne.libelle}</em><span>{ligne.montantEUR} €</span></div>
            ))}
            <div><em><strong>Total des recettes</strong></em><span><strong>{config.finances.recettesEUR} €</strong></span></div>
          </div>
        </div>
        <div class="card entity">
          <div class="entity__t">Où va l'argent</div>
          <h3 style="font-size:15px;margin-top:14px">Actions humanitaires — {config.finances.sousTotalActionsEUR} €</h3>
          <div class="dl" style="margin-top:10px">
            {config.finances.detailDepensesActions.map((ligne) => (
              <div><em>{ligne.libelle}</em><span>{ligne.montantEUR} €</span></div>
            ))}
          </div>
          <h3 style="font-size:15px;margin-top:18px">Fonctionnement — {config.finances.sousTotalFonctionnementEUR} €</h3>
          <div class="dl" style="margin-top:10px">
            {config.finances.detailDepensesFonctionnement.map((ligne) => (
              <div><em>{ligne.libelle}</em><span>{ligne.montantEUR} €</span></div>
            ))}
          </div>
        </div>
      </div>
      <p class="rv" style="font-size:14.5px;color:var(--encre);margin-top:18px">
        Sur cet exercice, <strong>les actions humanitaires représentent près de 80 % des dépenses</strong> ; le fonctionnement (administration, personnel du centre, frais bancaires) en représente à peine plus de 20 %.
      </p>
      <p class="rv" style="font-size:13.5px;color:var(--gris);margin-top:10px">
        Bureau de l'association — Présidente : <strong>{config.dirigeants.presidente}</strong> · Trésorier : <strong>{config.dirigeants.tresorier}</strong>. Le détail complet figure dans le document ci-dessous.
      </p>
      <div class="card entity rv" style="margin-top:26px">
        <div class="entity__t">Et la maison mère, AMAAFE / Mali ?</div>
        <p style="font-size:14.5px;color:var(--gris);margin-top:12px;line-height:1.7">
          L'entité malienne fonctionne avec un budget annuel d'environ <strong>{fmtNombre(config.financesMali.cotisationsAnnuellesFCFA)} FCFA</strong> de cotisations des membres, complété par des dons ponctuels. <strong>{config.financesMali.partFonctionnementCouturePct} %</strong> de ce budget finance le fonctionnement du <strong>centre de couture</strong>, où les enfants apprennent le métier de la couture, et <strong>{config.financesMali.partActionsPct} %</strong> les activités humanitaires. Son bilan détaillé sera publié ici dès sa validation par le bureau.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== DOCUMENTS ===== -->
  <section class="sec" style="background:var(--blanc);border-block:1px solid var(--ligne)">
    <div class="wrap">
      <div class="head rv">
        <div>
          <span class="eyebrow eyebrow--d">Documents</span>
          <h2>Documents à télécharger</h2>
        </div>
        <p class="lead" style="max-width:42ch">Les autres documents seront mis en ligne au fur et à mesure de leur validation par les instances de l'association.</p>
      </div>
      <div class="g3 rv">
        {documents.map((d) => (
          <a class="card entity" href={d.href}>
            <div class="entity__t">PDF{d.taille != null && ` — ${fmtTaille(d.taille)}`}</div>
            <h3 style="font-size:18px">{d.titre}</h3>
            <p style="font-size:13.5px;color:var(--gris);margin-top:8px">{d.description ? `${d.description} — ` : ''}Télécharger →</p>
          </a>
        ))}
        {!statutsPresents && (
          <div class="card entity">
            <div class="entity__t">Document</div>
            <h3 style="font-size:18px">Statuts de l'association</h3>
            <p style="font-size:13.5px;color:var(--gris);margin-top:8px">PDF à publier — <span class="tbd">à téléverser</span></p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ===== ENGAGEMENTS ===== -->
  <section class="sec">
    <div class="wrap">
      <div class="head rv">
        <div>
          <span class="eyebrow eyebrow--d">Nos engagements</span>
          <h2>Ce que nous nous engageons à faire</h2>
        </div>
      </div>
      <div class="eng rv" style="margin-top:0;max-width:820px">
        <div class="eng__i"><span class="eng__c">✓</span><div><b>Publier les comptes régulièrement</b><p>Les recettes et l'utilisation des dons seront rendues publiques sur ce site.</p></div></div>
        <div class="eng__i"><span class="eng__c">✓</span><div><b>Ne rien promettre qui ne soit confirmé</b><p>L'avantage fiscal en France n'est annoncé que depuis l'obtention du rescrit fiscal par AMAAFE / France ; chaque affirmation du site s'appuie sur un document vérifiable.</p></div></div>
        <div class="eng__i"><span class="eng__c">✓</span><div><b>Protéger les enfants</b><p>Aucune photo identifiable ni prénom réel publié sans autorisation écrite des parents.</p></div></div>
        <div class="eng__i"><span class="eng__c">✓</span><div><b>Répondre à toute question</b><p>Tout donateur peut demander des précisions sur l'utilisation des fonds via la <a href="/contact/" style="color:var(--vert);text-decoration:underline">page contact</a>.</p></div></div>
      </div>
    </div>
  </section>

</Base>
