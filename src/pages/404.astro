---
import Base from '../layouts/Base.astro';
---
<Base
  titre="Page introuvable | Centre Coranique Rahma"
  description="La page demandée n'existe pas ou a été déplacée."
>
  <section class="sec">
    <div class="wrap" style="text-align:center;max-width:640px">
      <span class="eyebrow eyebrow--r">Erreur 404</span>
      <h1 style="color:var(--vert);font-size:clamp(30px,4vw,46px);margin-top:14px">Cette page n'existe pas.</h1>
      <p class="lead" style="margin-top:16px">Le lien que vous avez suivi est peut-être erroné, ou la page a été déplacée.</p>
      <div class="hero__act" style="justify-content:center">
        <a class="btn btn--vert" href="/">Retour à l'accueil</a>
        <a class="btn btn--ghost" href="/contact/">Nous contacter</a>
      </div>
    </div>
  </section>
</Base>
